llvm.mlir.constant(0 : i32) : i32 // %0 is zero
llvm.mlir.constant(1 : i32) : i32 // %1 is one
llvm.mlir.constant(-5 : i32) : i32 // %0 is negative
llvm.mlir.constant(8 : i32) : i32 // %1 is positive

llvm.sub %arg0, %arg0 : i32 // %0 is zero

llvm.mul %arg0, %arg0 overflow<nsw> : i32 // %0 is nonnegative
!llvm.mul %arg0, %arg0 : i32 //

%0 = llvm.mlir.constant(1 : i32) : i32 // %0 is one
%1 = llvm.mul %arg0, %arg0 overflow<nsw> : i32 // %1 is nonnegative
%2 = llvm.add %1, %0 overflow<nsw> : i32 // %2 is positive
llvm.add %0, %0 : i32 // %7 is zero

%2 = llvm.mul %0, %1 overflow<nsw> : i32 // %2 is negative
%3 = llvm.mul %0, %0 overflow<nsw> : i32 // %3 is positive
%4 = llvm.sub %1, %0 overflow<nsw> : i32 // %4 is positive
%5 = llvm.sub %0, %1 overflow<nsw> : i32 // %5 is negative
%6 = llvm.add %1, %1 overflow<nsw> : i32 // %6 is positive
%7 = llvm.add %0, %0 overflow<nsw> : i32 // %7 is negative
!llvm.add %1, %1 : i32 //
!llvm.sub %1, %0 : i32 //

llvm.and %0, %arg0 : i32 // %2 is zero
llvm.and %arg0, %0 : i32 // %3 is zero
llvm.and %2, %arg0 : i32 // %4 is zero

// argument: %2 is zero
// argument: %2 is nonnegative
// argument: %2 is nonpositive
%3 = llvm.add %2, %1 overflow<nsw> : i32 // %3 is negative

!llvm.and %1, %1 : i32 //
!llvm.or %1, %arg0 : i32 //
!llvm.and %arg0, %1 : i32 //
